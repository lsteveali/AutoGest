<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla «Nueva factura» (mockup Nueva factura V1). El controlador arma la orden, los conceptos, el resumen y el pago sobre el VBox. -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.autogest.controller.billing.InvoiceNewController"
            styleClass="page-scroll"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED">
    <VBox fx:id="root" spacing="16" />
</ScrollPane>
