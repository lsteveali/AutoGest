<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<!-- Panel de inicio (Dashboard v1). El controlador arma el saludo, los
     indicadores y las tarjetas sobre el VBox interno; el ScrollPane evita que
     el contenido se recorte en la altura del shell. -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.autogest.controller.home.HomeController"
            styleClass="dashboard-scroll"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED">
    <VBox fx:id="root" spacing="16" />
</ScrollPane>
