<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Marcador del detalle de la orden. Lo reemplaza el Líder (detalle, estados,
     historial e integración de stock). Existe para que «Crear orden» y la fila
     de la lista tengan a dónde navegar desde el Sprint 4. -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           styleClass="empty-state">

    <VBox alignment="CENTER" spacing="12">
        <Label styleClass="page-title" text="Detalle de la orden" />
        <Label styleClass="page-subtitle" text="En construcción" />
    </VBox>

</StackPane>
