<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla «Detalle de la orden» (mockup Detalle orden). El controlador carga
     la orden por id y arma estado, cliente, vehículo, diagnóstico, servicios,
     repuestos, costos, responsable e historial sobre el VBox. -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.autogest.controller.order.OrderDetailController"
            styleClass="page-scroll"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED">
    <VBox fx:id="root" spacing="16" />
</ScrollPane>
