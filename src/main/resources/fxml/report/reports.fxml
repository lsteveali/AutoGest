<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla «Reportes» (mockup Reportes V1). El controlador arma el periodo, los indicadores,
     las gráficas y los resúmenes sobre el VBox. -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.autogest.controller.report.ReportsController"
            styleClass="page-scroll"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED">
    <VBox fx:id="root" spacing="16" />
</ScrollPane>
