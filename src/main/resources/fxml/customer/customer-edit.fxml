<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<!-- Formulario de cliente (mockup Nuevo cliente). Esta pantalla y su gemela
     (customer-new.fxml / customer-edit.fxml) usan el mismo controlador: si recibe
     el id de un cliente, edita; si no, registra uno nuevo. El controlador arma el
     formulario sobre el VBox. El ScrollPane existe porque el shell no tiene
     barra de desplazamiento y el formulario es más alto que la ventana. -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.autogest.controller.customer.CustomerFormController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="customer-scroll">
    <stylesheets>
        <URL value="@../../css/customers.css" />
    </stylesheets>
    <content>
        <VBox fx:id="root" styleClass="customer-page" />
    </content>
</ScrollPane>
