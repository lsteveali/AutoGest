<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla «Clientes» (mockup Cliente). El controlador arma el encabezado, los
     indicadores, los filtros y la tabla sobre este VBox; los estilos propios del
     módulo vienen de customers.css. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.autogest.controller.customer.CustomerListController"
      fx:id="root" styleClass="customer-page">
    <stylesheets>
        <URL value="@../../css/customers.css" />
    </stylesheets>
</VBox>
