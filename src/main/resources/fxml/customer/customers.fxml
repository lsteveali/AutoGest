<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla «Clientes» (mockup Cliente). El controlador arma el encabezado, los
     indicadores, los filtros y la tabla sobre el VBox «root»; los estilos propios del
     módulo vienen de customers.css. El ScrollPane deja desplazarse cuando la ventana
     es baja, así la tabla nunca se aplasta (Líder, 24/11/2026). -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.autogest.controller.customer.CustomerListController"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="module-scroll">
    <stylesheets>
        <URL value="@../../css/customers.css" />
    </stylesheets>
    <content>
        <VBox fx:id="root" styleClass="customer-page" />
    </content>
</ScrollPane>
