<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla general de Configuración (mockup «Configuración»). El controlador
     arma la tarjeta del usuario, las secciones y la información del sistema
     sobre el VBox; el ScrollPane evita que se recorte en ventanas bajas. -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.autogest.controller.settings.SettingsController"
            styleClass="page-scroll"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED">
    <VBox fx:id="root" spacing="20" />
</ScrollPane>
