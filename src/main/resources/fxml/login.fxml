<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla de inicio de sesión (mockup Login). Panel izquierdo con la marca y
     el eslogan; a la derecha, la tarjeta con correo, contraseña y recordarme. -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.autogest.controller.user.LoginController"
      styleClass="login-root">

    <VBox styleClass="login-brand" HBox.hgrow="ALWAYS">
        <Label text="AutoGest" styleClass="login-brand-title" />
        <Label text="Gestión inteligente para tu taller." styleClass="login-brand-slogan" wrapText="true" />
        <Region VBox.vgrow="ALWAYS" />
        <Label styleClass="login-brand-footnote" wrapText="true"
               text="Sistema de gestión integral para talleres automotrices." />
    </VBox>

    <StackPane styleClass="login-form-side" HBox.hgrow="ALWAYS">
        <VBox styleClass="login-card" maxWidth="400" maxHeight="-Infinity">
            <Label text="Iniciar sesión" styleClass="login-title" />
            <Label text="Ingresa con tu correo y contraseña para continuar."
                   styleClass="page-subtitle" wrapText="true" />

            <VBox spacing="6">
                <Label text="Correo electrónico" styleClass="field-label" />
                <TextField fx:id="emailField" promptText="correo@autogest.com" styleClass="input" />
            </VBox>

            <VBox spacing="6">
                <Label text="Contraseña" styleClass="field-label" />
                <PasswordField fx:id="passwordField" promptText="Tu contraseña" styleClass="input" />
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <CheckBox fx:id="rememberCheck" text="Recordarme" />
                <Region HBox.hgrow="ALWAYS" />
                <Hyperlink text="¿Olvidaste tu contraseña?" disable="true" />
            </HBox>

            <Label fx:id="errorLabel" styleClass="login-error" wrapText="true" managed="false" visible="false" />

            <Button fx:id="loginButton" text="Iniciar sesión" maxWidth="Infinity"
                    styleClass="btn-primary" defaultButton="true" />
        </VBox>
    </StackPane>

</HBox>
