<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla «Servicios» (catálogo). El controlador arma los indicadores,
     los filtros y la tabla sobre el VBox «root». El ScrollPane deja desplazarse
     cuando la ventana es baja, así la tabla nunca se aplasta. -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.autogest.controller.catalog.ServicesController"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="module-scroll">
    <content>
        <VBox fx:id="root" spacing="20" />
    </content>
</ScrollPane>
