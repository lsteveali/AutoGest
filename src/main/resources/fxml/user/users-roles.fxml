<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla «Usuarios y roles» (mockup Usuarios y roles). El controlador arma
     los indicadores, filtros, la tabla y la tarjeta de roles sobre el VBox. El
     ScrollPane existe porque la tarjeta de roles va debajo de la tabla: sin él,
     en ventanas bajas la tabla se encogía hasta no mostrar usuarios. -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.autogest.controller.user.UsersRolesController"
            styleClass="page-scroll"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED">
    <VBox fx:id="root" spacing="20" />
</ScrollPane>
