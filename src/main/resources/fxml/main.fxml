<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>

<?import com.autogest.controller.components.AssistantButton?>
<?import com.autogest.controller.components.Sidebar?>
<?import com.autogest.controller.components.Topbar?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.autogest.controller.MainController"
            styleClass="app-shell">

    <!-- Izquierda: navegación oficial (reutilizable por todas las pantallas). -->
    <left>
        <Sidebar fx:id="sidebar" />
    </left>

    <!-- Arriba: cabecera con campana y usuario actual. -->
    <top>
        <Topbar fx:id="topbar" />
    </top>

    <!-- Centro: área donde el ViewNavigator carga las pantallas y botón flotante del Asistente. -->
    <center>
        <StackPane>
            <StackPane fx:id="contentArea" styleClass="content-area" />
            <AssistantButton fx:id="assistantButton" StackPane.alignment="BOTTOM_RIGHT" />
        </StackPane>
    </center>

</BorderPane>
